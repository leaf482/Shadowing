# Copy this file to .env and fill in values before deploying

# Port the Node server listens on (Caddy/nginx proxies to this)
PORT=3000

# Absolute path to SQLite database file
# Defaults to server/shadowing.db relative to server/index.js if not set
# SQLITE_PATH=/home/ubuntu/shadowing/server/shadowing.db

# Shadowing request cooldown in days (14–21, default 14)
# COOLDOWN_DAYS=14

# --- Email verification (Resend) ---
# Sign up at https://resend.com — free tier: 3,000 emails/month
# Verify your domain at: https://resend.com/domains
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# The "From" address shown to users (must match your verified domain in Resend)
FROM_EMAIL=Shadow Network <noreply@shadowingnetwork.com>
