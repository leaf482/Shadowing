{
  "name": "shadowing-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --import ./instrument.mjs server/index.js",
    "dev": "vite --host",
    "dev:server": "node --import ./instrument.mjs server/index.js",
    "dev:seed": "node server/seed.js",
    "dev:full": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "dev:all": "npm run dev:seed && npm run dev:full",
    "build": "node scripts/export-clinics-static.mjs && vite build",
    "generate:intro-map": "node scripts/generate-intro-map-tacoma.mjs",
    "preview": "vite preview",
    "test:smoke:auth": "node --test server/auth.smoke.test.mjs",
    "migrate:dynamo": "node scripts/migrate-sqlite-to-dynamo.mjs",
    "migrate:dynamo:from-stack": "bash scripts/migrate-dynamo-from-stack.sh",
    "cleanup:artifacts": "node scripts/cleanup-artifacts.mjs",
    "deploy:static": "node scripts/sync-static-cdn.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1046.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1056.0",
    "@aws-sdk/client-dynamodb": "^3.1046.0",
    "@aws-sdk/client-s3": "^3.1046.0",
    "@aws-sdk/lib-dynamodb": "^3.1046.0",
    "@sentry/node": "^10.53.1",
    "@sentry/react": "^10.53.1",
    "amazon-cognito-identity-js": "^6.3.16",
    "aws-jwt-verify": "^5.1.1",
    "compression": "^1.8.1",
    "express": "^4.19.2",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^5.0.0",
    "serverless-http": "^4.0.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "sharp": "^0.34.5",
    "vite": "^6.4.2"
  }
}
